<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only real, crawlable URLs belong in a sitemap.

  The old version listed "./index.html" and eight fragment URLs
  ("./index.html#/collection/all" ...). Both are broken:
    1. Relative <loc> is invalid — the spec requires an absolute URL.
    2. A "#fragment" is not a separate page to a crawler. Google strips it,
       so all nine entries pointed at the same URL.

  There is exactly one page here, so there is exactly one entry.
  If the repo is renamed (ruh- -> ruh), update <loc> in this file and the
  Sitemap: line in robots.txt.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://kareeem7.github.io/Ruh/</loc>
    <lastmod>2026-11-12</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
